{
  "comments": {
    "lineComment": { "comment": "#", "noIndent": false }
  },
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "onEnterRules": [
    {
      "beforeText": ".*",
      "action": { "indent": "outdent" }
    }
  ]
}
