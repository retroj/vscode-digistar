{
  "name": "digistar",
  "publisher": "digistarusersgroup",
  "displayName": "Digistar Script",
  "description": "Syntax highlighting for Digsitar Script",
  "repository": "github:retroj/vscode-digistar",
  "version": "0.0.4",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "digistar",
        "extensions": [
          ".ds",
          ".lis"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "digistar",
        "scopeName": "source.digistar",
        "path": "./syntaxes/digistar.tmGrammar.json"
      }
    ],
    "configurationDefaults": {
      "[digistar]": {
        "editor.tabSize": 12,
        "editor.insertSpaces": false,
        "editor.detectIndentation": false,
        "editor.renderWhitespace": "trailing",
        "editor.wordBasedSuggestions": "matchingDocuments"
      }
    },
    "configuration": {
      "title": "Digistar Script",
      "properties": {
        "digistar.indentNewLine": {
          "type": "string",
          "default": "always",
          "enum": [
            "always",
            "never",
            "auto"
          ],
          "description": "Controls whether a new line is automatically indented when pressing Enter."
        }
      }
    },
    "commands": [
      {
        "command": "digistar.indentLine",
        "title": "Digistar Script Indent Line"
      },
      {
        "command": "digistar.playScript",
        "title": "Digistar Script Play",
        "icon": "$(play)"
      },
      {
        "command": "digistar.fadestopreset",
        "title": "Digistar FadeStopReset",
        "icon": "$(sync)"
      }
    ],
    "keybindings": [
      {
        "command": "digistar.indentLine",
        "key": "tab",
        "when": "editorTextFocus && editorLangId == digistar && !suggestWidgetVisible"
      },
      {
        "command": "digistar.indentLineAndEnter",
        "key": "enter",
        "when": "editorTextFocus && editorLangId == digistar && !suggestWidgetVisible"
      },
      {
        "command": "digistar.playScript",
        "key": "Ctrl-k Ctrl-p",
        "when": "editorTextFocus && editorLangId == digistar"
      },
      {
        "command": "digistar.fadestopreset",
        "key": "Ctrl-k Ctrl-r",
        "when": "editorTextFocus && editorLangId == digistar"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "digistar.playScript",
          "group": "navigation@1",
          "when": "editorLangId == digistar"
        },
        {
          "command": "digistar.fadestopreset",
          "group": "navigation@2",
          "when": "editorLangId == digistar"
        }
      ],
      "explorer/context": [
        {
          "command": "digistar.playScript",
          "group": "navigation",
          "when": "explorerResourceIsFolder == false && resourceExtname == .ds"
        }
      ]
    }
  },
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "files": [
    "LICENSE.md",
    "README.md",
    "language-configuration.json",
    "syntaxes/digistar.tmGrammar.json",
    "out/extension.js",
    "out/commands.js",
    "resources/scripts/fadestopreset.ds"
  ],
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/vscode": "^1.90.0"
  }
}
