{
  "name": "digistar",
  "publisher": "jjfoerch",
  "displayName": "Digistar Script Syntax Highlighter",
  "description": "Syntax highlighting for Digsitar Script",
  "repository": "github:retroj/vscode-digistar",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "digistar",
        "extensions": [".ds", ".lis"]
      }
    ],
    "grammars": [
      {
        "language": "digistar",
        "scopeName": "source.digistar",
        "path": "./syntaxes/digistar.tmGrammar.json"
      }
    ]
  },
  "files": [
    "LICENSE.md",
    "README.md",
    "syntaxes/digistar.tmGrammar.json"
  ]
}
