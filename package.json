{
  "name": "digistar",
  "publisher": "digistarusersgroup",
  "displayName": "Digistar Script",
  "description": "Syntax highlighting for Digsitar Script",
  "repository": "github:retroj/vscode-digistar",
  "version": "0.0.2",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "digistar",
        "extensions": [
          ".ds",
          ".lis"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "digistar",
        "scopeName": "source.digistar",
        "path": "./syntaxes/digistar.tmGrammar.json"
      }
    ],
    "configurationDefaults": {
      "[digistar]": {
        "editor.tabSize": 12,
        "editor.insertSpaces": false,
        "editor.detectIndentation": false,
        "editor.renderWhitespace": "trailing"
      }
    },
    "commands": [
      {
        "command": "digistar.indentLine",
        "title": "Digistar Script Indent Line"
      }
    ],
    "keybindings": [
      {
        "command": "digistar.indentLine",
        "key": "tab",
        "when": "editorTextFocus && editorLangId == digistar && !suggestWidgetVisible"
      }
    ]
  },
  "activationEvents": [
    "onLanguage:digistar"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "files": [
    "LICENSE.md",
    "README.md",
    "language-configuration.json",
    "syntaxes/digistar.tmGrammar.json",
    "out/extension.js"
  ],
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/vscode": "^1.90.0"
  }
}
