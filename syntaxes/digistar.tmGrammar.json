{
  "scopeName": "source.digistar",
  "patterns": [
    { "include": "#errors" },
    { "include": "#comments" },
    { "include": "#timestamps" },
    { "include": "#durations" },
    { "include": "#strings" },
    { "include": "#classes" },
    { "include": "#attrtypes" }
  ],
  "repository": {
    "errors": {
      "patterns": [
        { "name": "invalid.illegal.digistar",
          "match": "^!.*$" }
      ]
    },
    "comments": {
      "patterns": [
        { "name": "comment.line.versionstamp.digistar",
          "match": "^#\\s{\\[(?:\\d+\\.)+\\d+\\]}$" },
        { "name": "comment.line.digistar",
          "match": "[#;].*$" }
      ]
    },
    "timestamps": {
      "patterns": [
        { "match": "^\\s*\\+?[0-9:.]+",
          "name": "constant.numeric.timestamp.digistar" }
      ]
    },
    "durations": {
      "patterns": [
        { "match": "(?i)\\b(dur(?:ation)?)[0-9:.%\\s]*(?=$|[#;])",
          "captures": {
            "1": { "name": "keyword.other.duration.digistar" }
          }
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.digistar",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.digistar",
          "match": "\\\\."
        }
      ]
    },
    "classes": {
      "patterns": [
        { "match": "(?i)\\bis\\s+(\\w+Class)\\b",
          "captures": {
            "1": { "name": "support.class.digistar" }
          }
        },
        { "match": "(?i)\\b(\\w+Class)\\s+(is\\s+class|attribute|command|lock|allowChildren|group|\\w+\\s+(flags|default|minimum|maximum))\\b",
          "captures": {
            "1": { "name": "support.class.digistar" }
          }
        }
      ]
    },
    "attrtypes": {
      "patterns": [
        {
          "match": "(?i)\\b(?:(?:mem|EDID|driver|firmware)?path|(?:on)?Image|showLogo|(?:screen)?model|geoidElevation|(?:(?:ion)?Color|position|poly|label|normal|elevation|coastline|night|cloudFlow)Texture|gammaTable|frequency|cache|play(?:\\s(?:permanent)?)?|dataset|preferences|include|directory|(?:js|model|audio|video|image)Dir|open|dissolve|(?:kernel|modelTexture)\\s\\d+|(?:testPattern|mask)?Pathname|displayIntersectionMap|controlsPreview|launch|processContent|(?:mesh|spatialReference)?File)\\s(.+)(?=$|[#;])",
          "captures": {
            "1": { "name": "variable.parameter.pathname.digistar" }
          }
        }
      ]
    }
  }
}
