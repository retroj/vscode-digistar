{
  "scopeName": "source.digistar",
  "patterns": [
    { "include": "#errors" },
    { "include": "#comments" },
    { "include": "#timestamps" },
    { "include": "#durations" },
    { "include": "#strings" },
    { "include": "#classes" },
    { "include": "#attrtypes"}
  ],
  "repository": {
    "errors": {
      "patterns": [
        { "name": "invalid.illegal.digistar",
          "match": "^!.*$" }
      ]
    },
    "comments": {
      "patterns": [
        { "name": "comment.line.digistar",
          "match": "[#;].*$" }
      ]
    },
    "timestamps": {
      "patterns": [
        { "match": "^\\s*\\+?[0-9:.]+",
          "name": "constant.numeric.timestamp.digistar" }
      ]
    },
    "durations": {
      "patterns": [
        { "match": "\\b(dur(?:ation)?)[0-9:.%\\s]*(?=$|[#;])",
          "captures": {
            "1": { "name": "keyword.other.duration.digistar" }
          }
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.digistar",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.digistar",
          "match": "\\\\."
        }
      ]
    },
    "classes": {
      "patterns": [
        {
          "name": "support.class.digistar",
          "match": "\\b(asterismData|asterismGroupPrefs|asterismPreferences|asteroid|asteroidGroupPrefs|asteroidPreferences|atmosphere|audio3D|audio|audioInput|aurora|auroraPreferences|autoAlign|autoBlend|blackHole|blackHolePreferences|bodyInfo|button|camera|capture|cityLightsTexture|cityLightsTexturePreferences|cloud|cloudPreferences|comet|cometGroupPrefs|cometPreferences|complexLinePreferences|complexObjectPreferences|composition|compositionLayer|connector|constellationData|constellationGroupPrefs|constellationPreferences|controlInfo|cylinder|daylightSolidModel|daylightSolidModelPreferences|deviceGroup|dials|domeAudio|domeVideo|dot|dotCloud|dotCloudPreferences|dotModel|dotModelPreferences|dotPreferences|drawMode|dsAtlas|dsAtlasPreferences|dsoData|dsoGroupPrefs|dsoPreferences|dsoVolumeData|dsoVolumePreferences|duModel|duModelPreferences|dwarfPlanetGroupPrefs|earthSatelliteData|earthSatellitePreferences|earthSatGroupPrefs|empty|emptyPreferences|ephemeris|exoplanetData|exoplanetGroupPrefs|exosystemData|exosystemGroupPrefs|fileExtensionInfo|flight|galaxy|galaxyPreferences|genericData|gp|gpStats|guide2Preferences|guide3Preferences|guideData|guidePreferences|hipsImagery|host|hostStats|image|interleaveFrames|javaScript|javaScriptInfo|joystick|kinectSensor|kinectUser|kml|kmlControl|layeredElevation|layeredImagery|light|lightPreferences|lineModel|lineModelPreferences|localPlugin|localPluginStats|menuItem|meteorShower|meteorShowerData|meteorShowerGroupPrefs|meteorShowerPreferences|modelTextureSemantics|moonGroupPrefs|mouse|navigation|navigationControls|noiseTexture|objectGroup|orbit|orbiter|particle|path|pickMap|placemark|planet|planetData|planetGroupPrefs|planetPreferences|plugin|pluginStats|projector|projectors|remoteTheater|satellite|satelliteOrbiter|scene|script|scriptInfo|show|sky|skyPreferences|skySurvey|skySurveyPreferences|slider|slideset|slidesetPreferences|solidModel|solidModelPreferences|spacecraftData|spacecraftGroupPrefs|spacecraftPreferences|speak|spheroidScalarField|spheroidVectorField|spiceKernel|ssBodyInfoPreferences|sssbData|star|starData|starfield|starIdGroupPrefs|starInfo|starInfoPreferences|starPreferences|starSystemData|starSystemGroupPrefs|starTexture|starTexturePreferences|stereo|sun|sunPreferences|surface|syncCard|system|systemObjectGroup|systemObjectOff|systemStats|telescope|text2|text2Preferences|text|textPreferences|textureComposition|textureModel|textureModelPreferences|theater|timepieceLine|toastImagery|toggle|trail|tychoStar|tychoStarsPreferences|ui|video|videoInput|virtualStick|volume|volumeModelPreferences|waypoint|WMPlayer|wmsImagery|wmtsImagery|xbox)Class\\b"
        }
      ]
    },
    "attrtypes": {
      "patterns": [
        {
          "match": "\\b(?:(?:mem|EDID|driver|firmware)?path|(?:on)?Image|showLogo|(?:screen)?model|geoidElevation|(?:(?:ion)?Color|position|poly|label|normal|elevation|coastline|night|cloudFlow)Texture|gammaTable|frequency|cache|play(?:\\s(?:permanent)?)?|dataset|preferences|include|directory|(?:js|model|audio|video|image)Dir|open|dissolve|(?:kernel|modelTexture)\\s\\d+|(?:testPattern|mask)?Pathname|displayIntersectionMap|controlsPreview|launch|processContent|(?:mesh|spatialReference)?File)\\s(.+)(?=$|[#;])",
          "captures": {
            "1": { "name": "variable.parameter.pathname.digistar" }
          }
        }
      ]
    }
  }
}
