{
  "scopeName": "source.digistar",
  "patterns": [
    { "include": "#keywords" },
    { "include": "#strings" }
  ],
  "repository": {
    "keywords": {
      "patterns": [
        { "match": "^\\s*\\+?[0-9:.]+",
          "name": "constant.numeric.timestamp" }
      ]
    },
    "strings": {
      "name": "string.quoted.double.digistar",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.digistar",
          "match": "\\\\."
        }
      ]
    }
  }
}
